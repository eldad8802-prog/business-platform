{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/payments/reconciliation",
      "schedule": "40 2 * * *"
    },
    {
      "path": "/api/payments/settlement-recovery",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/intake/sweep",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/transactional-email/sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/accountant/sweep",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/appointments/booking/sweep",
      "schedule": "*/10 * * * *"
    }
  ]
}
