# Identity of the ONE permanent QA tenant this directory provisions.
#
# These are repository constants, deliberately NOT workflow inputs. The
# production workflow reads this file and nothing else, so it can never be
# pointed at another name, another person or another address: changing who gets
# provisioned requires a reviewed commit, not a dispatch form.
#
# The guard (scripts/ci/collection-qa-tenant-guard.mjs) pins the two names to
# exact literals it carries itself, and refuses to run while the email is still
# unset. That is the stop gate: the workflow CANNOT execute until the owner
# fixes the final address here, in a reviewed change.
#
# Rules the guard enforces on the email:
#   - not the placeholder below
#   - already normalized (lower-case, no surrounding whitespace), because
#     lib/auth/signup-identity.ts#normalizeEmail folds case before storing and
#     login looks the folded form up first
#   - shaped like an address, by the same permissive test signup uses
#   - local part starts with "collection-qa", so the address is unmistakably
#     this tenant's and cannot quietly become a person's mailbox

COLLECTION_QA_EMAIL="collection-qa-sandbox@example.test"
COLLECTION_QA_BUSINESS_NAME="QA COLLECTION SANDBOX — אין להשתמש"
COLLECTION_QA_USER_NAME="QA Collection Sandbox"

# The rows provisioning actually created, in Production, on 2026-09-23
# (run 35792246475). They are recorded here because the password-repair
# workflow may touch ONE row and must be able to say which one before it
# touches anything: the address alone would still be an identity the database
# resolves at write time, and these ids make the target immutable and checkable
# in advance. The guard pins both values itself.
COLLECTION_QA_BUSINESS_ID="38"
COLLECTION_QA_USER_ID="33"
