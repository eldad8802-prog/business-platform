<?xml version="1.0" encoding="utf-8"?>
<!--
  SEC-F / M-8: nothing from this app is backed up or transferred. Every data
  domain is excluded for cloud backup AND device-to-device transfer (Android 12+).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
