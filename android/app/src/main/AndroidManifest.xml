<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      enableOnBackInvokedCallback: predictive-back opt-in. targetSdk 36 stops
      delivering onBackPressed/KEYCODE_BACK; Capacitor's @capacitor/app plugin
      registers an AndroidX OnBackPressedCallback, which the dispatcher bridges
      to the OnBackInvoked path — so back keeps reaching the web `backButton`
      listener (lib/native/native-shell.ts) with predictive animations intact.
    -->
    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          Credential sharing with the website (password manager). Declares the
          site statement in @string/asset_statements; the matching
          /.well-known/assetlinks.json on promaxgroup.co.il completes the pair.
          Grants nothing by itself and opens no links in the app.
        -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!--
          Push (FCM): notifications the system draws while the app is in the
          background land on the app's own channel (created at start-up by
          NotificationChannels.java) with the monochrome status-bar icon, instead
          of FCM's fallback channel and the launcher icon.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="dubiz_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_dubiz" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      CAMERA: lets the WebView file-chooser offer direct capture for the
      product's core "צילום מסמך" flow (input capture=environment). Declared
      optional so camera-less devices stay installable.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      POST_NOTIFICATIONS (Android 13+): declared only. Nothing requests it at
      start-up — the web app asks from an explicit action by the person
      (lib/native/push-notifications.ts requestPushPermission).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11+): without this, Capacitor's file chooser
      cannot resolve the camera app (resolveActivity(IMAGE_CAPTURE) == null)
      and "צילום מסמך" falls back to the photo picker. Visibility only — no new
      permission. Proven on API 34/36 emulators (runs 42529183894, 42530068048).
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>
</manifest>
