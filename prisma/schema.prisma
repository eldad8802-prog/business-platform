generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContentFeedback {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  success      Boolean
  goal         String?
  valueType    String?
  category     String?
  customerType String?
  serviceLevel String?
  tone         String?
  hook         String?
  idea         String?
  script       String?

  @@index([goal, valueType])
}

/// ContentRun
/// Why: One content creation run (shared context + provenance) that groups variants.
/// Source of truth: Run-level context snapshot + lifecycle status.
/// Intentionally NOT here: Per-variant creative variables, render outputs, performance/learning.
model ContentRun {
  id              Int              @id @default(autoincrement())
  businessId      Int
  createdByUserId Int?
  status          ContentRunStatus @default(PENDING)

  /// JSON governance: must include { schemaVersion, generatedAt, source, data }.
  inputSnapshot           Json
  businessContextSnapshot Json?
  metadata                Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  variants ContentVariant[]
  events   ContentEvent[]

  @@index([businessId, createdAt])
}

/// ContentVariant
/// Why: Comparable unit per run (DNA + blueprint/score/semantics + render plan).
/// Source of truth: Immutable snapshots of creative variables produced by the pipeline.
/// Intentionally NOT here: Media blobs, analytics/performance, learning/memory tables.
model ContentVariant {
  id           Int                  @id @default(autoincrement())
  contentRunId Int
  variantKey   String
  status       ContentVariantStatus @default(PENDING)

  /// JSON governance: must include { schemaVersion, generatedAt, source, data }.
  creativeDna       Json
  creativeBlueprint Json
  renderBlueprint   Json
  creativeScore     Json
  growthSemantics   Json
  llmOutput         Json?

  provenance Json?
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentRun ContentRun      @relation(fields: [contentRunId], references: [id], onDelete: Cascade)
  renders    ContentRender[]
  events     ContentEvent[]

  @@unique([contentRunId, variantKey])
}

/// ContentRender
/// Why: Track external render lifecycle and store only URLs + minimal provider metadata.
/// Source of truth: Provider status + outputUrl (not the video file itself).
/// Intentionally NOT here: Storing the actual media, heavy provider dumps.
model ContentRender {
  id               Int                   @id @default(autoincrement())
  contentVariantId Int
  provider         ContentRenderProvider
  status           ContentRenderStatus   @default(QUEUED)

  outputUrl    String?
  thumbnailUrl String?

  completedAt  DateTime?
  failedAt     DateTime?
  errorCode    String?
  errorMessage String?

  /// JSON governance: must include { schemaVersion, generatedAt, source, data } when present.
  providerPayload Json?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentVariant ContentVariant @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)

  @@index([contentVariantId, createdAt])
}

/// ContentEvent
/// Why: Append-only timeline of product/system events for runs/variants.
/// Source of truth: Event log (immutable per row).
/// Intentionally NOT here: Strongly-typed event taxonomy (eventType stays String), analytics.
model ContentEvent {
  id               Int  @id @default(autoincrement())
  businessId       Int
  contentRunId     Int?
  contentVariantId Int?
  actorUserId      Int?

  /// Intentionally String (aligned with LearningEvent.eventType).
  eventType String

  /// JSON governance: must include { schemaVersion, generatedAt, source, data } when present.
  payload  Json?
  metadata Json?

  createdAt DateTime @default(now())

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contentRun     ContentRun?     @relation(fields: [contentRunId], references: [id], onDelete: Cascade)
  contentVariant ContentVariant? @relation(fields: [contentVariantId], references: [id], onDelete: Cascade)
  actorUser      User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([contentRunId, createdAt])
  @@index([contentVariantId, createdAt])
}

model Business {
  id                        Int                             @id @default(autoincrement())
  name                      String
  archivedAt                DateTime?
  archivedByUserId          Int?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  billingDocuments          BillingDocument[]
  billingAuditEvents        BillingAuditEvent[]
  billingNumberSequences    BillingDocumentNumberSequence[]
  billingPaymentAllocations BillingPaymentAllocation[]
  profile                   BusinessProfile?
  botSettings               BusinessBotSettings?
  bot                       BusinessBot?
  services                  BusinessService[]
  collaborationDeals        CollaborationDeal[]
  conversations             Conversation[]
  issuedCoupons             Coupon[]                        @relation("BusinessIssuedCoupons")
  customers                 Customer[]
  deals                     Deal[]
  documentsV2               Document[]
  emailAttachmentImports    EmailAttachmentImport[]
  whatsappAttachmentImports WhatsAppAttachmentImport[]
  emailConnections          EmailConnection[]
  documents                 FinancialDocument[]
  financialRecords          FinancialRecord[]
  financialEvents           FinancialEvent[]
  inventoryAlerts           InventoryAlert[]
  inventoryCategories       InventoryCategory[]
  inventoryDrafts           InventoryDraft[]
  inventoryExternalSales    InventoryExternalSale[]
  inventoryItems            InventoryItem[]
  inventoryMovements        InventoryMovement[]
  inventoryPendingMatches   InventoryPendingMatch[]
  leads                     Lead[]
  learningEvents            LearningEvent[]
  learningSignals           LearningSignal[]
  messages                  Message[]
  offers                    Offer[]
  posApiKeys                POSApiKey[]
  posProductMappings        POSProductMapping[]
  pricingCalculations       PricingCalculation[]
  pricingProfiles           PricingProfile[]
  recommendations           Recommendation[]
  recommendationOutcomes    RecommendationOutcome[]
  issuedRedemptions         RedemptionEvent[]               @relation("IssuedCouponRedemptions")
  redeemedRedemptions       RedemptionEvent[]               @relation("RedeemedCouponRedemptions")
  replySuggestions          ReplySuggestion[]
  supplierPurchaseDrafts    SupplierPurchaseDraft[]
  tasks                     Task[]
  appointments              Appointment[]
  users                     User[]
  vendorLearnings           VendorLearning[]
  contentRuns               ContentRun[]
  contentEvents             ContentEvent[]
  productUsageEvents        ProductUsageEvent[]
  businessFeatureAccess     BusinessFeatureAccess[]
  whatsappConnection        WhatsAppConnection?
  purchaseOrders            PurchaseOrder[]
  receivingSessions         ReceivingSession[]
  suppliers                 Supplier[]
  archivedByUser              User?                           @relation("BusinessArchivedBy", fields: [archivedByUserId], references: [id], onDelete: SetNull)
  billingAuthorityConnections BillingAuthorityConnection[]
  billingAuthoritySubmissions BillingAuthoritySubmission[]
  parties                     Party[]
  partyResolutionClaims       PartyResolutionClaim[]
  botFieldAnswers             BotFieldAnswer[]
  supplierProducts            SupplierProduct[]
  representationMappings      RepresentationMapping[]
  catalogSources              CatalogSource[]
  catalogClaims               CatalogClaim[]
  supplierConnections         SupplierConnection[]
  monthCloses                 MonthClose[]

  @@index([archivedAt])
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  password            String
  name                String?
  businessId          Int
  role                UserRole             @default(USER)
  lastLoginAt         DateTime?
  loginCount          Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contentRunsCreated  ContentRun[]
  contentEvents       ContentEvent[]
  billingAuditEvents  BillingAuditEvent[]
  platformAuditEvents PlatformAuditEvent[]
  productUsageEvents  ProductUsageEvent[]
  appointmentsCreated Appointment[]
  archivedBusinesses                       Business[]                   @relation("BusinessArchivedBy")
  billingAuthorityConnectionsOauthAuthorized BillingAuthorityConnection[] @relation("BillingAuthorityOauthAuthorizedBy")
  monthClosesClosed                        MonthClose[]                 @relation("MonthClosedBy")
}

/// Append-only product usage analytics (distinct from weekly `Usage` quota counters).
model ProductUsageEvent {
  id         String   @id @default(cuid())
  businessId Int?
  userId     Int?
  sessionId  String?
  featureKey String
  action     String
  outcome    String?
  entityType String?
  entityId   String?
  durationMs Int?
  source     String   @default("api")
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([featureKey, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([createdAt])
}

/// Append-only audit trail for platform-level admin actions (cross-tenant).
model PlatformAuditEvent {
  id          Int      @id @default(autoincrement())
  actorUserId Int?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

/// Platform feature catalog row — key must match `PLATFORM_FEATURE_KEYS` in code.
model PlatformFeatureDefinition {
  key            String   @id
  displayName    String
  category       String
  description    String   @default("")
  defaultEnabled Boolean  @default(true)
  mutable        Boolean  @default(true)
  createdAt      DateTime @default(now())

  policy            PlatformFeaturePolicy?
  businessOverrides BusinessFeatureAccess[]
}

/// Global policy per feature (defaults + emergency kill switch).
model PlatformFeaturePolicy {
  featureKey        String   @id
  globalEnabled     Boolean  @default(true)
  emergencyDisabled Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedByUserId   Int?

  definition PlatformFeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)
}

/// Sparse per-business overrides only (no row = inherit global/catalog).
model BusinessFeatureAccess {
  id              Int                        @id @default(autoincrement())
  businessId      Int
  featureKey      String
  state           BusinessFeatureAccessState
  reason          String?
  updatedByUserId Int?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  business   Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  definition PlatformFeatureDefinition @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@unique([businessId, featureKey])
  @@index([businessId])
  @@index([featureKey])
}

model BusinessProfile {
  id                      Int      @id @default(autoincrement())
  businessId              Int      @unique
  category                String?
  subCategory             String?
  businessModel           String?
  /// Legal / display name on tax invoices (falls back to Business.name when empty)
  billingLegalName        String?
  /// EXEMPT_DEALER | AUTHORIZED_DEALER | LTD_COMPANY — Israeli business registration category
  billingBusinessKind     String?
  billingTaxId            String?
  billingVatNumber        String?
  billingPhone            String?
  billingEmail            String?
  billingAddress          String?
  billingPaymentNote      String?
  billingFooterNote       String?
  /// Small logo as data URL — pdfmake/HTML renderer embed only (no remote fetch)
  billingLogoDataUrl      String?
  /// CLASSIC | MODERN | COMPACT — drives billing PDF layout presets (business-wide).
  billingPdfTemplateStyle String   @default("CLASSIC")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([subCategory])
  @@index([businessModel])
}

/// Per-business starter bot configuration (runtime wiring is separate).
model BusinessBotSettings {
  id                          Int      @id @default(autoincrement())
  businessId                  Int      @unique
  enabled                     Boolean  @default(false)
  mode                        String   @default("STARTER")
  channel                     String   @default("WHATSAPP")
  welcomeMessage              String?
  questions                   Json?
  finalAction                 String?
  finalActionPayload          Json?
  handoffRules                Json?
  showDraftSuggestionsInInbox Boolean  @default(false)
  /// Product Link Mode v1: single catalog/landing URL (no commerce engine).
  productLinkEnabled          Boolean  @default(false)
  productLinkUrl              String?
  productLinkIntro            String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  business                    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// Bot Builder root identity (Stage 1, intentionally thin).
///
/// Identity ONLY — no runtime state. Runtime config (enabled/workMode/questions/
/// welcome/finalAction/handoffRules) stays in `BusinessBotSettings`, which the
/// conversation pipeline reads. This root is reconciled with it by `businessId`
/// and is NEVER read by the response-planner or the pipeline. Singleton per
/// business for now (`businessId @unique`); multi-bot is deliberately deferred.
model BusinessBot {
  id          Int                 @id @default(autoincrement())
  businessId  Int                 @unique
  displayName String?
  avatar      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  business       Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  profile        BusinessBotProfile?
  goalSelections BotGoalSelection[]
  setupDraft     BusinessBotSetupDraft?
  knowledge      BusinessBotKnowledge?
  recommendations BusinessBotRecommendation[]
}

/// Descriptive, advisory profile branch under `BusinessBot` (Stage 1).
///
/// `voice` / `personality` / `approach` are grouped JSON, each constrained by
/// app-side allow-list validators in `lib/features/bot` — never free-form JSON.
/// Advisory only: NOT consumed by the response-planner or the pipeline.
model BusinessBotProfile {
  id          Int         @id @default(autoincrement())
  botId       Int         @unique
  voice       Json?
  personality Json?
  approach    Json?
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bot         BusinessBot @relation(fields: [botId], references: [id], onDelete: Cascade)
}

/// A goal the business selected for its bot (Stage 2 — Goal Library).
///
/// Corrigible intent label, not behaviour. `goalKey` references the read-only
/// Goal Catalog in `lib/features/bot/bot-goals`. Copy-with-provenance:
/// `goalVersion` + `selectedAt` freeze WHAT was chosen WHEN, so a future
/// catalog change never retroactively rewrites a business's selection. NOT
/// materialized into BusinessBotSettings and NOT read by the pipeline.
model BotGoalSelection {
  id          Int         @id @default(autoincrement())
  botId       Int
  goalKey     String
  goalVersion Int
  selectedAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bot         BusinessBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, goalKey])
  @@index([botId])
}

/// Setup Wizard staging draft (Stage 3). Staging ONLY.
///
/// Holds the in-progress wizard: selected goals, current step, and a FROZEN
/// `assembledBase` snapshot (copy-with-provenance: each assembled item records
/// its source goals + the snapshot stamps the catalog version + `assembledAt`).
/// Client-writable status stops at REVIEW_READY. ACTIVATED is set ONLY by the
/// activate route (Stage 5) — a controlled, minimal copy of the frozen
/// `assembledBase` into the EXISTING BusinessBotSettings fields the planner
/// already reads. `activatedAt` + `activationMeta` keep activation provenance
/// OFF the planner path. Never changes mode/workMode/handoff/enabled.
model BusinessBotSetupDraft {
  id               Int         @id @default(autoincrement())
  botId            Int         @unique
  status           String      @default("DRAFT")
  currentStep      Int         @default(0)
  selectedGoalKeys Json?
  assembledBase    Json?
  assembledAt      DateTime?
  activatedAt      DateTime?
  activationMeta   Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  bot              BusinessBot @relation(fields: [botId], references: [id], onDelete: Cascade)
}

/// Advisory business knowledge for the bot builder (Stage 4).
///
/// FAQ / hours / address / notes the business wants its bot to "know". ADVISORY
/// only: NOT read by the response-planner or the pipeline, NOT materialized into
/// BusinessBotSettings. services/pricing + catalog link keep their existing
/// sources of truth (BusinessService / BusinessBotSettings.productLink*).
model BusinessBotKnowledge {
  id        Int         @id @default(autoincrement())
  botId     Int         @unique
  hours     String?
  address   String?
  notes     String?
  faq       Json?
  version   Int         @default(1)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bot       BusinessBot @relation(fields: [botId], references: [id], onDelete: Cascade)
}

/// Opt-in recommendation for the bot builder (Stage 6).
///
/// Generated when goals change on an established bot. A recommendation NEVER
/// changes anything by itself — it is stored + shown only. `apply` is a
/// disabled placeholder (no runtime write). NOT read by the planner/pipeline.
/// `type` is granular (subject baked in) so we can dedupe per (botId, type).
model BusinessBotRecommendation {
  id                Int         @id @default(autoincrement())
  botId             Int
  type              String
  status            String      @default("PROPOSED")
  reason            String
  payload           Json?
  sourceGoalKey     String?
  sourceGoalVersion Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  appliedAt         DateTime?
  dismissedAt       DateTime?
  bot               BusinessBot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, status])
  @@index([botId, type])
}

/// Structured capture of a customer's answer to a single bot field.
///
/// Derived layer ABOVE Message: `rawValue` is a verbatim snapshot (kept even if
/// the source Message is later purged), `sourceMessageId` is provenance only
/// (SetNull on Message delete). `parsedValue`/`parseStatus`/`confidence` are
/// lazily filled by a future parser — not in this stage. Current answer per
/// (conversationId, fieldKey) is enforced by a partial unique index
/// (supersededAt IS NULL), added manually in the migration SQL.
model BotFieldAnswer {
  id                   Int                  @id @default(autoincrement())
  businessId           Int
  conversationId       Int
  sourceMessageId      Int?
  fieldKey             String
  partyRole            String               @default("CUSTOMER")
  rawValue             String
  rawKind              String               @default("text")
  parsedValue          Json?
  parseStatus          BotAnswerParseStatus @default(UNPARSED)
  confidence           Float?
  capturedAt           DateTime             @default(now())
  supersededAt         DateTime?
  supersededByAnswerId Int? // soft pointer (no FK in this stage)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceMessage Message?     @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([conversationId, fieldKey])
  @@index([sourceMessageId])
  @@index([parseStatus])
}

model BusinessService {
  id                     Int                     @id @default(autoincrement())
  businessId             Int
  name                   String
  type                   BusinessServiceType
  description            String?
  basePrice              Float?
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  business               Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  deals                  Deal[]
  pricingRecommendations PricingRecommendation[]
  costProfile            ServiceCostProfile?
}

model Lead {
  id            Int            @id @default(autoincrement())
  businessId    Int
  customerName  String?
  phone         String?
  sourceChannel String?
  status        LeadStatus     @default(NEW)
  temperature   Float?
  currentStage  String?
  valueEstimate Float?
  quotedPrice   Float?
  finalPrice    Float?
  currency      String?        @default("ILS")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  deals         Deal[]
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
}

model Customer {
  id               Int               @id @default(autoincrement())
  businessId       Int
  name             String
  /// Canonical-form phone (digits-only, IL-aware E.164-ish). Always written
  /// through `normalizeCustomerPhone()` — never raw input. Null means the
  /// customer has no phone on record (legitimate state). NULLs do not
  /// collide under Postgres unique-constraint semantics.
  phone            String?
  email            String?
  city             String?
  /// Registered legal name when different from display `name` (billing snapshots).
  legalName        String?
  /// Counterparty tax identifier (ע.מ. / ח.פ. / ת.ז. etc.).
  taxId            String?
  taxIdType        CustomerTaxIdType?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  billingDocuments BillingDocument[]
  conversations    Conversation[]
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages         Message[]
  appointments     Appointment[]

  @@unique([businessId, phone])
}

model Deal {
  id                       Int              @id @default(autoincrement())
  businessId               Int
  leadId                   Int?
  businessServiceId        Int?
  quotedPrice              Float?
  finalPrice               Float?
  currency                 String?          @default("ILS")
  estimatedCost            Float?
  actualCost               Float?
  estimatedDurationMinutes Int?
  actualDurationMinutes    Int?
  discountAmount           Float?
  discountPercent          Float?
  grossProfitAmount        Float?
  grossMarginPercent       Float?
  status                   String?
  lostReason               String?
  wonAt                    DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  business                 Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessService          BusinessService? @relation(fields: [businessServiceId], references: [id])
  lead                     Lead?            @relation(fields: [leadId], references: [id])
}

model CollaborationDeal {
  id             String                  @id @default(uuid())
  businessId     Int
  title          String
  description    String
  partnerType    String
  actionType     CollaborationActionType
  estimatedValue Int
  matchScore     Int?
  reasonText     String?
  priority       Int?
  sourceType     String?
  status         CollaborationDealStatus @default(NEW)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
  @@index([priority])
  @@index([businessId, status])
  @@index([businessId, priority])
}

model Offer {
  id                  Int      @id @default(autoincrement())
  issuingBusinessId   Int
  title               String
  description         String?
  customerBenefitText String
  validUntil          DateTime
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  imageUrl            String?
  coupons             Coupon[]
  issuingBusiness     Business @relation(fields: [issuingBusinessId], references: [id], onDelete: Cascade)

  @@index([issuingBusinessId])
  @@index([validUntil])
  @@index([isActive])
}

model Coupon {
  id                Int              @id @default(autoincrement())
  offerId           Int
  issuingBusinessId Int
  token             String           @unique
  qrValue           String           @unique
  issuedAt          DateTime         @default(now())
  expiresAt         DateTime
  status            CouponStatus     @default(ACTIVE)
  redeemedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  publicId          String           @unique @default(uuid()) @db.Uuid
  issuingBusiness   Business         @relation("BusinessIssuedCoupons", fields: [issuingBusinessId], references: [id], onDelete: Cascade)
  offer             Offer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  redemptionEvents  RedemptionEvent?

  @@index([offerId])
  @@index([issuingBusinessId])
  @@index([status])
  @@index([expiresAt])
}

model RedemptionEvent {
  id                  Int      @id @default(autoincrement())
  couponId            Int      @unique
  issuingBusinessId   Int
  redeemingBusinessId Int
  redeemedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  coupon              Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  issuingBusiness     Business @relation("IssuedCouponRedemptions", fields: [issuingBusinessId], references: [id], onDelete: Cascade)
  redeemingBusiness   Business @relation("RedeemedCouponRedemptions", fields: [redeemingBusinessId], references: [id], onDelete: Cascade)

  @@index([issuingBusinessId])
  @@index([redeemingBusinessId])
  @@index([redeemedAt])
}

model Conversation {
  id                        Int                        @id @default(autoincrement())
  businessId                Int
  customerId                Int?
  leadId                    Int?
  channel                   ConversationChannel
  status                    ConversationStatus         @default(OPEN)
  currentStage              ConversationStage?
  outcomeStatus             ConversationOutcomeStatus?
  intentType                String?
  intentConfidence          Float?
  sentimentSnapshot         String?
  temperatureScore          Float?
  closeProbabilitySnapshot  Float?
  outcomeReason             String?
  lostReason                String?
  startedAt                 DateTime                   @default(now())
  lastMessageAt             DateTime?
  closedAt                  DateTime?
  firstResponseLatencySec   Int?
  avgResponseLatencySec     Int?
  unansweredInboundCount    Int                        @default(0)
  customerLastInboundAt     DateTime?
  businessLastOutboundAt    DateTime?
  lastAnalysisAt            DateTime?
  pendingFollowUp           Json?
  pendingAppointmentRequest Json?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  business                  Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
