model PartyResolutionClaim {
  id               Int                    @id @default(autoincrement())
  businessId       Int
  partyId          Int
  subjectType      PartyRoleType
  subjectId        Int
  signalType       PartySignalType?
  signalValue      String?
  confidence       PartyClaimConfidence
  method           PartyResolutionMethod  @default(DETERMINISTIC_EXACT)
  source           String
  resolvedByUserId Int?
  status           PartyClaimStatus       @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, subjectType, subjectId])
  @@index([businessId, signalType, signalValue])
  @@index([businessId, partyId])
  @@index([businessId, status])
}

