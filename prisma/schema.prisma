// =============================================================================
// Document Memory & Learning — Phase 1A: Correction Ledger Foundation.
//
// Write-only, APPEND-ONLY historical fact store. NOT a learning system.
// No reads back into the engine, no priors, no re-ranking, no candidate
// landscape. Scalar-only (no Prisma relations) so existing models are NOT
// touched; document/business links are plain ids resolved at analysis time.
// Captured 100% additively and never allowed to fail upload/approve.
// =============================================================================

/// Engine belief at extraction time (the moment runUnifiedDocumentIntelligence
/// returns), captured before the chosen-value subset is persisted to
/// ExtractedData. One row per extraction event (append-only; never updated).
model ExtractionSnapshot {
  id            Int      @id @default(autoincrement())
  documentId    Int
  businessId    Int
  occurredAt    DateTime @default(now())
  sourceChannel String

  // Provenance
  liveEngineVersion String
  ocrEngine         String
  ocrVersion        String
  ocrTextHash       String?

  // Memory Scope (raw — NO entity resolution, NO normalization)
  vendorName   String?
  documentType String?
  direction    String?

  // Engine belief (denormalized first-class for the key fields)
  amount             Float?
  date               DateTime?
  category           String?
  confidenceScore    Float?
  amountConfidence   String?
  vendorConfidence   String?
  dateConfidence     String?
  categoryConfidence String?
  isFinancial        Boolean?
  amountEligible     Boolean?
  financialEvidenceLevel String?
  guardrailRoute     String?

  // Full, lossless engine result (forward-compatible provenance)
  rawResult Json

  @@index([documentId])
  @@index([businessId, occurredAt])
}

/// Human verdict at approve time, captured before ExtractedData is overwritten.
/// Stores both the original engine belief and the human-confirmed final value,
/// plus the raw business context. One row per approve event (append-only).
model ReviewEvent {
  id             Int      @id @default(autoincrement())
  documentId     Int
  businessId     Int
  occurredAt     DateTime @default(now())
  reviewerUserId Int

  // Outcome / document-type context
  approvedAs        String // "financial" | "document"
  explicitFinancial Boolean
  profileId         String?

  // Memory Scope (raw — belief vs human-confirmed)
  vendorBelief    String?
  vendorFinal     String?
  directionBelief String?
  directionFinal  String?

  // Per-field verdict + delta: { field: { belief, final, verdict, delta? } }
  verdicts  Json
  // Lossless provenance
  rawBelief Json
  rawFinal  Json

  @@index([documentId])
  @@index([businessId, occurredAt])
}

