  business        Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines           SupplierPurchaseDraftLine[]

  @@index([businessId])
  @@index([businessId, status])
}

model SupplierPurchaseDraftLine {
  id            Int                   @id @default(autoincrement())
  draftId       Int
  rawName       String?
  sku           String?
  barcode       String?
  quantity      Float
  unitType      InventoryUnitType?
  unitCost      Float?
  matchedItemId Int?
  matchScore    Float?
  decision      SupplierLineDecision?
  status        SupplierLineStatus    @default(PENDING)
  // Phase 2 forward-link: the SupplierProduct identity learned at approval.
  supplierProductId Int?
  createdAt     DateTime              @default(now())
  draft         SupplierPurchaseDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  item          InventoryItem?        @relation(fields: [matchedItemId], references: [id])
  supplierProduct SupplierProduct?    @relation(fields: [supplierProductId], references: [id])

  @@index([draftId])
  @@index([matchedItemId])
  @@index([supplierProductId])
}

model Supplier {
  id                  Int                @id @default(autoincrement())
  businessId          Int
  name                String
  isActive            Boolean            @default(true)
  phone               String?
  email               String?
  // Identity signal for Party Resolution (Supplier = Party Role, Phase 1).
  // Strong establishing signal (KNOWN). Optional; NOT unique at table level —
  // identity uniqueness lives in the Party/claim layer to avoid over-merge.
  taxId               String?
  taxIdType           CustomerTaxIdType?
  notes               String?
  defaultLeadTimeDays Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierProducts    SupplierProduct[]
  catalogSources      CatalogSource[]
  connections         SupplierConnection[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, name])
  @@index([businessId, taxId])
}

// Supplier Domain — Connections Foundation. Represents HOW a business exchanges
// data with a supplier (manual / email / CSV import / API placeholder). This is a
// capability/provenance shell ONLY: no transport, no sync, no credentials, no
// scheduler. It never authors identity or inventory; catalog data still enters
// solely via explicit Catalog ingestion, and orders are still shared via the
// existing sharedAt event.
model SupplierConnection {
  id             Int                           @id @default(autoincrement())
  businessId     Int
  supplierId     Int
  connectionType SupplierConnectionType
  status         SupplierConnectionStatus      @default(ACTIVE)
  // Capability model only — declares what a connection COULD do; nothing is
  // executed automatically in this Foundation.
  capabilities   SupplierConnectionCapability[]
  metadata       Json?
  // "Last used to exchange data" (manual import/share). No background sync.
  lastSyncAt     DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  business       Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier       Supplier                      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogSources CatalogSource[]

  @@index([businessId])
  @@index([supplierId])
  @@index([businessId, supplierId])
  @@index([businessId, status])
}

enum SupplierConnectionType {
  MANUAL
  EMAIL
  CSV_IMPORT
  API_PLACEHOLDER
}

enum SupplierConnectionStatus {
  ACTIVE
  INACTIVE
}

enum SupplierConnectionCapability {
  CAN_IMPORT_CATALOG
  CAN_RECEIVE_ORDER
  CAN_REPORT_STATUS
  CAN_REPORT_AVAILABILITY
}

// Supplier Domain Phase 2 — Identity Learning (Reported Reality reference).
// "How a supplier names a product" — scoped to one Supplier, NEVER a Product
// Master and NEVER authoritative over InventoryItem. Carries identity signals
// only (sku / barcode / name): no price, no unit/Measure, no availability.
// Created lazily inside the approval transaction; deduped per identity signal.
model SupplierProduct {
  id             Int                         @id @default(autoincrement())
  businessId     Int
  supplierId     Int
  // Supplier-reported identity signals (Establishing: externalSku, barcode).
  externalSku    String?
  barcode        String?
  // Supporting signal: supplier's display name + a normalized form for lookup.
  rawName        String?
  normalizedName String?
  isActive       Boolean                     @default(true)
  // Provenance of first observation, e.g. "draft:{id}:line:{lineId}".
  source         String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  business       Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier       Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  mappings       RepresentationMapping[]
  draftLines     SupplierPurchaseDraftLine[]

  @@index([businessId])
  @@index([supplierId])
  @@index([supplierId, externalSku])
  @@index([supplierId, barcode])
  @@index([supplierId, normalizedName])
}

// Supplier Domain Phase 2 — Representation Mapping (Identity dimension only).
// Mirrors PartyResolutionClaim: a corrigible binding-belief that links a
// SupplierProduct to an InventoryItem, carrying confidence + method +
// provenance. Append-only history — superseded rows become RETRACTED, never
// deleted. Single ACTIVE row per SupplierProduct is enforced in application
// code (retract-then-insert), matching the PartyResolutionClaim convention.
// Phase 2 is Identity ONLY — no Measure / unit conversion dimension here.
model RepresentationMapping {
  id                 Int                   @id @default(autoincrement())
  businessId         Int
  supplierProductId  Int
  inventoryItemId    Int
  identityConfidence PartyClaimConfidence
  method             PartyResolutionMethod @default(HUMAN_CONFIRMED)
  // Which signal established the link (e.g. "sku" / "barcode" / "name").
  identitySignal     String?
  // Phase 3 — Measure (Representation Conversion). `factor` = stock-units per 1
  // purchase-unit; null ⇒ 1:1. Carried on the same mapping row; per-order
  // snapshots on PO/Receiving lines preserve the factor used at order time.
  purchaseUnitName        String?
  factor                  Float?
  measureConfidence       PartyClaimConfidence?
  measureSource           String?
  measureResolvedByUserId Int?
  source             String
  resolvedByUserId   Int?
  status             PartyClaimStatus      @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierProduct    SupplierProduct       @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([supplierProductId])
  @@index([supplierProductId, status])
  @@index([businessId, inventoryItemId])
  @@index([businessId, status])
}

// Supplier Domain Catalog — provenance anchor for a batch of claims (one import /
// future sync). Append-only; holds NO catalog values, no record authority, no
// transport/credentials. The Evidence "Account / Observer" of the claims.
model CatalogSource {
  id          Int               @id @default(autoincrement())
  businessId  Int
  supplierId  Int
  sourceType  CatalogSourceType
  actorUserId Int?
  occurredAt  DateTime          @default(now())
  metadata    Json?
  // Optional provenance: which SupplierConnection this import batch came through.
  // Nullable — direct/legacy ingestion has no connection. SetNull on delete.
  connectionId Int?
  createdAt   DateTime          @default(now())
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier    Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  connection  SupplierConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  claims      CatalogClaim[]

  @@index([businessId])
  @@index([supplierId])
  @@index([businessId, supplierId, occurredAt])
  @@index([connectionId])
}

// Supplier Domain Catalog — append-only Claims Ledger ATOM: ONE supplier
// assertion about ONE attribute of ONE subject at one time, with provenance.
// Reported Reality — informs the Record, NEVER authors it. The current offer is a
// DERIVED read-model (no stored "current", no freshness fields here). CONTENT is
// insert-only; only corrigibility metadata (status/supersededAt/retracted*) may
// change. Subject is POLYMORPHIC (subjectType+subjectId) with NO FK — and
// deliberately NO FK to InventoryItem (guard rail: catalog never authors Record).
model CatalogClaim {
  id              Int                    @id @default(autoincrement())
  businessId      Int
  subjectType     CatalogSubjectType
  subjectId       Int
  attribute       CatalogAttribute
  valueType       CatalogValueType
  valueNumber     Float?
  valueText       String?
  valueBool       Boolean?
  currency        String?
  observedAt      DateTime?
  recordedAt      DateTime               @default(now())
  sourceId        Int
  provenanceGrade CatalogProvenanceGrade @default(PROVIDER_ATTESTED)
  status          CatalogClaimStatus     @default(ACTIVE)
  supersededAt    DateTime?
  retractedAt     DateTime?
  retractedReason String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  source          CatalogSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, subjectType, subjectId, attribute, status], map: "CatalogClaim_subject_attr_status_idx")
  @@index([businessId, subjectType, subjectId, attribute, observedAt], map: "CatalogClaim_subject_attr_observed_idx")
  @@index([sourceId])
  @@index([businessId, status])
}

enum CatalogSourceType {
  MANUAL_ENTRY
  FILE_IMPORT
}

enum CatalogSubjectType {
  SUPPLIER_PRODUCT
  SUPPLIER
}

enum CatalogAttribute {
  ASKING_PRICE
  AVAILABILITY
  PACKAGE_DESCRIPTION
  MINIMUM_ORDER_AMOUNT
  LEAD_TIME_DAYS
}

enum CatalogValueType {
  MONEY
  NUMBER
  TEXT
  BOOLEAN
}

enum CatalogClaimStatus {
  ACTIVE
  SUPERSEDED
  RETRACTED
}

enum CatalogProvenanceGrade {
  PROVIDER_ATTESTED
  INTERPRETED
}

model PurchaseOrder {
