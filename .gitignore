# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.local
.env.*.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local debug / temp
/tmp/

# local generated artifacts (e.g. billing PDFs)
/storage/

# uploads (user-generated content; keep out of git)
/public/uploads/

# local artifacts (debug exports)
/pricing-page.html
/pricing-response.json

# tsc temp output files
tsc_out*.txt
tsc_output.txt
tsc_final.txt

# QA result snapshots (code stays, data outputs don't)
tmp_qa/*.json
tmp_qa/*.log

# local artifacts (debug exports, screenshots) - keep out of git
/artifacts/

# local docs screenshots
/docs/screenshots/

# prisma local db files (never commit)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.sqlite
/prisma/*.sqlite-journal

# windows junk
Thumbs.db
Desktop.ini

# cursor
.cursor/

# local secrets (never commit)
/secrets/
node_modules
stash-backup-*.patch

# Leads W1 E2E fixture — holds short-lived auth tokens for the QA tenants.
# Never commit: it is a secret by construction, and it is regenerated per run.
.leads-e2e/

# Local Dubiz Mist verification scratch (screenshots, diff harness) — never committed.
.tmp-mist/
